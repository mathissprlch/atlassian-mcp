# Confluence is reached via its REST API and needs these three values.
# Jira does NOT use these — it uses acli's own stored login (run `acli jira auth login`).
CONFLUENCE_SITE=your-site.atlassian.net
[email protected]
ATLASSIAN_API_TOKEN=your_api_token

# Optional
# ACLI_PATH=acli
# ACLI_TIMEOUT_MS=120000
# ATLASSIAN_MCP_READ_ONLY=false
