# Confluence (always) and one Jira tool (jira_workitem_transitions) reach Atlassian
# via its REST API and need these three values. Other Jira tools use acli's own
# stored login (`acli jira auth login`).
ATLASSIAN_SITE=your-site.atlassian.net
# (CONFLUENCE_SITE is accepted as a synonym for ATLASSIAN_SITE.)
[email protected]
ATLASSIAN_API_TOKEN=your_api_token

# Optional
# ACLI_PATH=acli
# ACLI_TIMEOUT_MS=120000

# Writes are DISABLED by default. Set to true to allow create/edit/transition/delete
# and any non-GET Confluence request.
# ATLASSIAN_MCP_ALLOW_WRITES=true
